WITH city_visits AS (
  SELECT
    location_city,
    COUNT(DISTINCT session_key) AS total_visits,
    MIN(event_date) AS first_event_date
  FROM clickstream_logs_analytics
  GROUP BY location_city
),

city_customer_first_event AS (
  SELECT
    location_city,
    customer_key,
    MIN(event_date) AS min_event_date
  FROM clickstream_logs_analytics
  GROUP BY location_city, customer_key
),

city_orders AS (
  SELECT
    c.location_city,
    COUNT(DISTINCT f.order_id) AS total_orders
  FROM city_customer_first_event c
  JOIN fact_sales_analytics f
    ON c.customer_key = f.customer_key
   AND f.date_key >= c.min_event_date
  GROUP BY c.location_city
)

SELECT
  s.store_key,
  s.city,
  s.region,
  COALESCE(v.total_visits, 0) AS total_visits,
  COALESCE(o.total_orders, 0) AS total_orders,
  ROUND(
    (COALESCE(o.total_orders, 0) * 100.0) / NULLIF(v.total_visits, 0),
    2
  ) AS conversion_rate_percentage
FROM dim_store_analytics s
LEFT JOIN city_visits v
  ON s.city = v.location_city
LEFT JOIN city_orders o
  ON s.city = o.location_city
ORDER BY
  conversion_rate_percentage DESC;