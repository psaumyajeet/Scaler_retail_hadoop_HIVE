SELECT 
    c.customer_key,
    c.city,
    c.state,
    ROUND(SUM(f.net_amount), 2) AS lifetime_value,
    COUNT(DISTINCT f.order_id) AS total_orders,
    ROUND(AVG(f.net_amount), 2) AS average_order_value
FROM fact_sales_analytics f
JOIN dim_customer_analytics c 
    ON f.customer_key = c.customer_key
GROUP BY 
    c.customer_key,
    c.city,
    c.state
ORDER BY 
    lifetime_value DESC
LIMIT 10;